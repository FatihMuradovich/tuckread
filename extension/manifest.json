{
  "manifest_version": 3,
  "name": "Tuckread",
  "short_name": "Tuckread",
  "version": "0.1.0",
  "description": "Save the page you're on to Tuckread in one click, and read it later without the noise.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Tuckread",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this page to Tuckread"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"]
}
