# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).
# Both values are safe to expose in the browser; never put the secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
